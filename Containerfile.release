# flue — a narrow channel from your host's SSH agent into a container
#
# Release image: a minimal, static distribution of the pre-built flue
# binary. It is FROM scratch with exactly one file in the image — /flue —
# and /flue as the entrypoint. flue embeds flue-broker (recoverable via
# `flue extract-broker`), so nothing else needs to be in the image. flue is
# built fully static (CGO_ENABLED=0) by the release workflow, which is why
# it can run on scratch with no libc or runtime. Nothing is compiled here —
# the image's bytes are exactly the attested bytes; the dev path (the
# Containerfile) is the one that compiles from source.
#
# Build (release workflow; the context carries one flue binary per
# architecture under dist/<arch>/):
#   buildx build --platform linux/amd64,linux/arm64 \
#     --build-arg VERSION=<tag> \
#     --build-arg REVISION=<commit sha> \
#     --build-arg CREATED=<rfc3339> \
#     -f Containerfile.release -t ghcr.io/snugmo/flue:<tag> .
#
# Usage (the entrypoint is /flue, so the subcommand and its arguments go
# straight after the image):
#   podman run --rm ghcr.io/snugmo/flue:latest version
#   podman run --rm ghcr.io/snugmo/flue:latest \
#     exec -- podman exec \
#     --preserve-fds 1 \
#     -e SSH_AUTH_SOCK=/tmp/flue.sock \
#     <target> flue-broker -sock /tmp/flue.sock

FROM scratch

# BuildKit fills TARGETARCH in per build platform, so each platform's
# build copies only its own architecture's flue binary from the context.
ARG TARGETARCH
# Stamped into the OCI well-known labels below (the binary already carries
# the version, stamped by the release workflow's build job).
ARG VERSION=latest
ARG REVISION=unknown
ARG CREATED=

# The single file in the image: the static flue binary at the root.
# --chown=0:0 (numeric, not "root":root) because scratch has no /etc/passwd
# to resolve a name; 0:0 is the only meaningful ownership, and with no USER
# instruction the process runs as uid 0 anyway.
COPY --chown=0:0 dist/flue_${TARGETARCH} /flue

# The binary is the whole image.
ENTRYPOINT ["/flue"]

# No base image, so no org.opencontainers.image.base.* label.
LABEL org.opencontainers.image.title="flue" \
      org.opencontainers.image.description="Filtered SSH agent bridge from host to container via SCM_RIGHTS control channel" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/flue" \
      org.opencontainers.image.documentation="https://github.com/snugmo/flue" \
      org.opencontainers.image.source="https://github.com/snugmo/flue.git" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      io.openshift.tags="dev,ssh,agent,proxy"
